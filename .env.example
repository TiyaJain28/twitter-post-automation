# ==============================================================================
# DEMOLY.DEV X AUTOMATION - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to a new file named `.env` and fill in your real credentials:
# In Windows Powershell / VS Code Terminal:
#   copy .env.example .env
#
# DO NOT commit your actual `.env` file to GitHub or share it with anyone!
# ==============================================================================

# 1. Google Gemini API Key
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Buffer Personal Access Token
# Get your token at: https://buffer.com/developers/api (Account -> Settings -> Access Tokens)
BUFFER_ACCESS_TOKEN=

# 3. Buffer Channel ID for your Demoly.dev X/Twitter account
# Leave empty initially! Run `python -m src.buffer_client --list-channels`
# to discover and paste your Twitter Channel ID here.
BUFFER_CHANNEL_ID=

# 4. Safety Controls
# DRY_RUN: When 'true', generates content, validates it, and logs without calling Buffer publishing.
# Set to 'false' only after you have tested thoroughly.
DRY_RUN=true

# LIVE_MODE: Must be explicitly 'true' to publish to live Twitter/X.
# Default is 'false' for complete safety.
LIVE_MODE=false

# 5. Media Hosting for Videos & Images (Optional)
# Public base URL where your assets/ directory is reachable by Buffer.
# For GitHub repos: https://raw.githubusercontent.com/<username>/<repo>/main
MEDIA_BASE_URL=

# 6. Hugging Face API Key (Optional - for AI image generation fallback)
# FREE to get at: https://huggingface.co/settings/tokens
# Used as Provider 2 in the image generation chain (after Pollinations.ai).
# Provider 1 (Pollinations.ai) is 100% free and needs NO key.
# Only set this if you want a higher-quality SDXL fallback option.
HF_API_KEY=
